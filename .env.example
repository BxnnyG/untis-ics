# Template for the environment file holding the secrets.
#
# systemd:
#   sudo install -m 600 -o root -g root /dev/null /etc/untis-ics.env
#   sudo nano /etc/untis-ics.env
#   ... then reference it with EnvironmentFile= in the unit
#
# Docker:
#   cp .env.example .env && chmod 600 .env
#
# The names must match password_env / token_env in config.yaml.

# --- WebUntis passwords ---
UNTIS_PASS_STUDENT1=
UNTIS_PASS_STUDENT2=

# --- Feed tokens (these appear in the subscription URL) ---
FEED_TOKEN_STUDENT1=
FEED_TOKEN_STUDENT2=

# --- Token for the /status endpoint. Unset means /status stays hidden. ---
STATUS_TOKEN=

# --- Optional: dead man's switch (Healthchecks.io, Uptime Kuma, ...) ---
HEARTBEAT_URL=

# --- Optional: override any app.* / server.* setting ---
# UNTIS_APP_TIMEZONE=Europe/Vienna
# UNTIS_APP_REFRESH_INTERVAL_MINUTES=10
