# Vorlage fuer /etc/untis-sync.env  (root:root, chmod 0600)
#
# Anlegen:
#   sudo install -m 600 -o root -g root /dev/null /etc/untis-sync.env
#   sudo nano /etc/untis-sync.env
#   sudo systemctl restart untis-calendar-sync
#
# Die Namen muessen zu password_env / token_env in der config.yaml passen.

# --- WebUntis-Passwoerter ---
UNTIS_PASS_BKUKR_FISI=
UNTIS_PASS_BKUKR_SGT=
UNTIS_PASS_KMS=

# --- Feed-Tokens (stehen in der Abo-URL) ---
FEED_TOKEN_BKUKR_FISI=
FEED_TOKEN_BKUKR_SGT=
FEED_TOKEN_KMS=
